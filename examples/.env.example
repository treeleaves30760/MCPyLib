# MCPyLib examples configuration
# Copy this file to .env (in this folder) and fill in your values.

# Server connection settings
SERVER_IP=127.0.0.1
SERVER_TOKEN=your_server_token_here # Shown in the server console at startup, or run /mcpylib token

# Your Minecraft username: most examples build around this player's position
PLAYER_NAME=YourMinecraftUsername
